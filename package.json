{
  "name": "realphoto-prompt-studio",
  "version": "1.0.0",
  "description": "RealPhoto Prompt Studio — офлайн-генератор фотореалистичных англоязычных промптов (React + TypeScript + Vite).",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --host",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "smoke": "node scripts/smoke-build.mjs",
    "e2e": "node scripts/e2e.mjs",
    "examples": "node scripts/generate-examples.ts",
    "verify": "npm run typecheck && npm test && npm run build && npm run smoke"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Juncker38/wefeer.git"
  },
  "license": "MIT",
  "type": "module",
  "bugs": {
    "url": "https://github.com/Juncker38/wefeer/issues"
  },
  "homepage": "https://github.com/Juncker38/wefeer#readme",
  "dependencies": {
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "axe-core": "^4.14.0",
    "playwright-core": "^1.64.1",
    "typescript": "^7.0.2",
    "vite": "^8.3.4",
    "vitest": "^5.0.5"
  },
  "private": true,
  "engines": {
    "node": ">=22"
  }
}
